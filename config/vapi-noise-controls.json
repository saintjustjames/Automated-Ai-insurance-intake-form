{
  "$comment": "Deployable assistant PATCH fragment for background-noise rejection. Verified against Vapi voice-pipeline and denoising documentation on 2026-08-25.",
  "backgroundSound": "off",
  "backgroundSpeechDenoisingPlan": {
    "smartDenoisingPlan": {
      "enabled": true
    },
    "fourierDenoisingPlan": {
      "enabled": false,
      "mediaDetectionEnabled": true
    }
