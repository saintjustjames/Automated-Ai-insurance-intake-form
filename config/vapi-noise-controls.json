      "ok",
      "yes",
      "yeah",
      "right",
      "sure",
      "alright",
      "got it",
      "uh-huh",
      "mm-hmm",
      "mhmm"
    ],
    "interruptionPhrases": [
      "stop",
      "wait",
      "hold on",
      "no",
      "agent",
      "representative",
      "human",
      "person",
      "emergency",
      "911",
      "spanish",
      "español",
      "kreyòl"
    ]
  },
  "startSpeakingPlan": {
    "waitSeconds": 0.8
  }
}
